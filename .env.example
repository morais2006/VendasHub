# =============================================================================
# VendaHub — variáveis de ambiente
#
# 1. Copie este arquivo para ".env" na raiz do projeto.
# 2. Preencha com os dados do SEU projeto Supabase.
# 3. O ".env" real nunca vai para o Git (já está no .gitignore).
#
# Um único arquivo atende a API e o front-end. O front-end recebe APENAS
# SUPABASE_URL e SUPABASE_PUBLISHABLE_KEY (definido em apps/web/vite.config.ts);
# nenhuma outra variável chega ao navegador.
# =============================================================================

# --- Supabase (Painel > Project Settings > API Keys) -------------------------
# URL do projeto: https://<project-ref>.supabase.co
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública (publishable "sb_publishable_..." ou a antiga "anon").
# Pode ir para o navegador: quem protege os dados é o RLS do PostgreSQL.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_substitua

# Chave secreta (secret "sb_secret_..." ou a antiga "service_role").
# SOMENTE no servidor: usada pelo seed de demonstração e pelos testes de
# integração. A API em execução não precisa dela para atender usuários.
SUPABASE_SECRET_KEY=sb_secret_substitua

# Usados pelo Supabase CLI (supabase link / db push). Opcionais para rodar o app.
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# --- API ---------------------------------------------------------------------
PORT=3333
# Origens liberadas no CORS (separe por vírgula).
WEB_ORIGIN=http://localhost:5173,http://localhost:4173
# Fuso usado nos filtros de período do dashboard.
APP_TIMEZONE=America/Sao_Paulo
LOG_LEVEL=info

# --- Redis -------------------------------------------------------------------
# Docker: npm run redis:up   |   Windows sem Docker: Memurai na porta 6379
REDIS_URL=redis://localhost:6379
# Prefixo das chaves (isola o VendaHub de outros apps no mesmo Redis).
REDIS_KEY_PREFIX=vendahub
# TTL em segundos: indicadores do dashboard e catálogo de produtos.
CACHE_TTL_DASHBOARD_SECONDS=60
CACHE_TTL_CATALOG_SECONDS=120

# --- Dados de demonstração (npm run db:seed) ---------------------------------
# Senha dos usuários fictícios criados pelo seed. Troque se quiser.
SEED_DEMO_PASSWORD=VendaHub@Demo2026
